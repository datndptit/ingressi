# ============================================================================
# Ingressi — mẫu .env cho triển khai Docker rootless (khớp cụm tham chiếu)
# Copy file này thành <repo>/.env rồi điền giá trị. KHÔNG commit .env thật.
#   * sinh secret:  openssl rand -hex 32   (riêng CLICKHOUSE_PASSWORD: -hex 24)
#   * node CÓ chạy ClickHouse Keeper: thêm ':docker-compose.keeper.yml' vào
#     cuối CẢ 2 biến COMPOSE_FILE và COMPOSE_EXTRA_FILES (xem chú thích dưới)
# ============================================================================

COMPOSE_PROJECT_NAME=ingressi

# Danh sách file compose theo thứ tự nạp (l4-port-manager cũng dùng danh sách
# này bên trong container qua COMPOSE_EXTRA_FILES).
COMPOSE_FILE=docker-compose.yml:docker-compose.argus.yml:docker-compose.crowdsec.yml:docker-compose.rootless.yml
# node keeper: COMPOSE_FILE=...#.rootless.yml:docker-compose.keeper.yml
COMPOSE_EXTRA_FILES=/compose/docker-compose.argus.yml:/compose/docker-compose.crowdsec.yml:/compose/docker-compose.rootless.yml
# node keeper: COMPOSE_EXTRA_FILES=...rootless.yml:/compose/docker-compose.keeper.yml

# Bật service theo profile (clickhouse luôn cần; geoipupdate nếu dùng GeoLite2)
COMPOSE_PROFILES=clickhouse,geoipupdate

# --- Secret (mỗi node một giá trị riêng) ---
SESSION_SECRET=<openssl rand -hex 32>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Adm9#<random 48 hex>
CROWDSEC_API_KEY=<openssl rand -hex 32>
CROWDSEC_POSTGRES_PASSWORD=<openssl rand -hex 32>
CLICKHOUSE_PASSWORD=<openssl rand -hex 24>

# --- Giá trị theo node ---
BASE_URL=http://<ip-node>:3000
HOSTNAME=<ten-node>

# --- Hằng số chung ---
INSTANCE_SYNC_ALLOW_HTTP=true
PUID=1001
PGID=1001
CADDY_GID=1001

# --- Argus ML sidecar ---
ARGUS_SOCKET_VOLUME=ingressi-argus-run
ARGUS_SOCKET=/run/argus/argus.sock
ARGUS_TIMEOUT_MS=50

# --- ClickHouse (analytics) ---
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=ingressi
CLICKHOUSE_DB=analytics
CLICKHOUSE_RETENTION_DAYS=30
# Image CH pin cứng (dùng chung cho keeper ở node chạy keeper)
CH_IMAGE=clickhouse/clickhouse-server:26.9.17.8-alpine
# Ghi chú: kit ch-repl (bước P3) sẽ thêm tham số quorum vào CLICKHOUSE_URL sau khi bật replication.

# --- Đăng ký tài khoản ---
AUTH_ALLOW_SELF_REGISTRATION=false
AUTH_ALLOW_OAUTH_REGISTRATION=false

# --- MaxMind GeoIP (điền nếu dùng profile geoipupdate) ---
GEOIPUPDATE_ACCOUNT_ID=CHANGEME
GEOIPUPDATE_LICENSE_KEY=CHANGEME
